# --- Supabase ---
# From Project Settings → API. The URL and publishable key are also exposed
# to the browser. (Supabase used to call this the "anon key"; same purpose,
# new name + format `sb_publishable_...`.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Service-role key — server-only, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection used by Drizzle (server-only).
# Use the "Session" pooler connection string for migrations / one-off scripts,
# and the "Transaction" pooler URL in production runtime if needed.
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- Web Push (VAPID) ---
# Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# --- Site (used in OAuth callback URL during local dev) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
